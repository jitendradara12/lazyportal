{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --workspace @juet/web run build",
  "outputDirectory": "packages/web/dist",
  "framework": "vite",
  "regions": ["bom1"],
  "redirects": [
    {
      "source": "/download",
      "destination": "https://github.com/jitendradara12/lazyportal/releases/latest/download/app-release.apk",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://localhost" }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [{ "source": "/api/:path*", "destination": "/api/proxy?path=:path*" }],
  "functions": {
    "api/proxy.js": {
      "maxDuration": 60,
      "includeFiles": "shared/portal-intermediate.pem"
    }
  }
}
