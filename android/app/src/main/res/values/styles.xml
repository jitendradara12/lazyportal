<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <!-- Brand colours. @color/colorPrimary & co. come from the Capacitor
             library's defaults, which are indigo/pink; use the navy from
             packages/web/public/icon.svg instead. -->
        <item name="colorPrimary">@color/ic_launcher_background</item>
        <item name="colorPrimaryDark">@color/ic_launcher_background</item>
        <item name="colorAccent">@color/ic_launcher_background</item>
    </style>

    <!-- App theme without action bar, supporting system DayNight (light & dark mode). -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/app_surface</item>
    </style>

    <!-- Launch (splash) theme using AndroidX Core SplashScreen. Matches the app's
         DayNight surface colour and centres the circular/adaptive launcher icon
         so there is no stretched/cropped full-screen bitmap or colour jump. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/app_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
