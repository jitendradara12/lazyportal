<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Brand colours. @color/colorPrimary & co. come from the Capacitor
             library's defaults, which are indigo/pink; use the navy from
             packages/web/public/icon.svg instead. -->
        <item name="colorPrimary">@color/ic_launcher_background</item>
        <item name="colorPrimaryDark">@color/ic_launcher_background</item>
        <item name="colorAccent">@color/ic_launcher_background</item>
    </style>

    <!-- Light-only: the web UI does not ship a dark theme, so follow the system
         here and let the WebView stay light regardless. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch (splash) theme. The app is single-activity, so the launch theme
         is the one the WebView is hosted in for the whole process: it paints
         the generated navy splash, hides the action bar and keeps the status
         bar light-on-dark (see values-v31/ for Android 12+'s own splash). -->
    <style name="AppTheme.NoActionBarLaunch.Base" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Styles do not merge across resource configurations, so Android 12+
         re-declares the style and inherits the items above from `.Base`. -->
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme.NoActionBarLaunch.Base" />
</resources>
